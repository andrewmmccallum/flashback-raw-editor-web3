{
  // Cloudflare Workers static-assets deploy. The Git build runs `npm run build`
  // (→ dist/), then `npx wrangler deploy` reads this and publishes dist/ as a
  // static site. Workers Assets honors public/_headers (COOP/COEP), which
  // libraw-wasm needs for SharedArrayBuffer.
  //
  // `name` MUST match your Cloudflare project/Worker name. It was created from
  // the repo, so it's almost certainly this — if your project is named
  // differently, change this and I'll re-push.
  "name": "flashback-raw-editor-web3",
  // Pin the account that owns the Flashback workers (deknared). Without this,
  // wrangler deploys to whatever single account the current OAuth token can
  // see — a token for the wrong account would silently CREATE a stray copy of
  // the worker there instead of failing. Pinned, it fails loudly instead.
  "account_id": "afc61245184f488490b2bde67e45e12f",
  "compatibility_date": "2026-06-13",
  "assets": {
    "directory": "./dist"
  }
}
